{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "ask": [
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__find_symbol",
      "mcp__serena__find_referencing_symbols"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.test)",
      "Read(./.env.test.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.staging)",
      "Read(./.env.staging.local)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/credentials.json)",
      "Read(./.npmrc)",
      "Read(./.pypirc)",
      "Read(./.netrc)",
      "Read(./.aws/credentials)",
      "Read(./.config/gcloud/application_default_credentials.json)",
      "Read(./**/.npmrc)",
      "Read(./**/.pypirc)",
      "Read(./**/.netrc)",
      "Read(./**/.aws/credentials)",
      "Read(./**/.config/gcloud/application_default_credentials.json)"
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.env.local",
        "./.env.development",
        "./.env.development.local",
        "./.env.test",
        "./.env.test.local",
        "./.env.production",
        "./.env.production.local",
        "./.env.staging",
        "./.env.staging.local",
        "~/.ssh",
        "~/.aws/credentials",
        "~/.config/gcloud/application_default_credentials.json",
        "~/.netrc",
        "~/.npmrc",
        "~/.pypirc",
        "**/*.env",
        "**/.env.local",
        "**/.env.development",
        "**/.env.development.local",
        "**/.env.test",
        "**/.env.test.local",
        "**/.env.production",
        "**/.env.production.local",
        "**/.env.staging",
        "**/.env.staging.local",
        "**/*.pem",
        "**/id_rsa",
        "**/id_ed25519",
        "**/credentials.json",
        "./.npmrc",
        "./.pypirc",
        "./.netrc",
        "./.aws/credentials",
        "./.config/gcloud/application_default_credentials.json",
        "**/.npmrc",
        "**/.pypirc",
        "**/.netrc",
        "**/.aws/credentials",
        "**/.config/gcloud/application_default_credentials.json"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "./.env",
          "mode": "deny"
        },
        {
          "path": "./.env.local",
          "mode": "deny"
        },
        {
          "path": "./.env.development",
          "mode": "deny"
        },
        {
          "path": "./.env.development.local",
          "mode": "deny"
        },
        {
          "path": "./.env.test",
          "mode": "deny"
        },
        {
          "path": "./.env.test.local",
          "mode": "deny"
        },
        {
          "path": "./.env.production",
          "mode": "deny"
        },
        {
          "path": "./.env.production.local",
          "mode": "deny"
        },
        {
          "path": "./.env.staging",
          "mode": "deny"
        },
        {
          "path": "./.env.staging.local",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws/credentials",
          "mode": "deny"
        },
        {
          "path": "~/.config/gcloud/application_default_credentials.json",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "~/.npmrc",
          "mode": "deny"
        },
        {
          "path": "~/.pypirc",
          "mode": "deny"
        },
        {
          "path": "./.npmrc",
          "mode": "deny"
        },
        {
          "path": "./.pypirc",
          "mode": "deny"
        },
        {
          "path": "./.netrc",
          "mode": "deny"
        },
        {
          "path": "./.aws/credentials",
          "mode": "deny"
        },
        {
          "path": "./.config/gcloud/application_default_credentials.json",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "OPENAI_API_KEY",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "failIfUnavailable": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.agents/runtime/agent_workspace.py"],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.agents/runtime/agent_workspace.py"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
