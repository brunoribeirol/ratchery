{
  "_comment": "Activation and installation registry. Agent entries are consumed by lib/adaptive_engine.resolve_active_agents() and lib/agent_workspace.install_agents(): tier-gated agents activate at a minimum effective tier, conditional agents activate from detected capabilities, and on-demand agents are installed only by `ratchery agents enable <name>`. The 4 original baseline agents (explorer, reviewer, security-reviewer, test-runner) also remain hardcoded in agent_workspace.ALWAYS_ON_AGENTS for backward compatibility. The skills.available inventory is consumed by global_guidance(); every listed global Skill is installed and advertised to both clients, while its full instructions load only when the client's description matching selects it. There is no fictitious always-on/on-demand split for globally installed Skills. The 4 project-level conditional Skills remain capability-triggered in install_conditional_skills().",
  "schema_version": "2.0.0",
  "metadata": {
    "_comment": "Capability Registry v2. Defaults are resolved with each entry; source paths and SHA-256 digests are computed from shipped assets by `ratchery skills/agents show`. Signals drive only deterministic advisory routing and offline evals -- clients remain responsible for actual invocation.",
    "defaults": {
      "version": "1.0.0",
      "origin": "ratchery",
      "clients": ["claude", "codex"],
      "network": "none",
      "permission_ceiling": "read-only",
      "anti_signals": [],
      "evals": []
    },
    "agents": {
      "explorer": {"signals": ["locate code", "find implementation path"], "anti_signals": ["implement the change"], "evals": ["agent-explorer-positive"]},
      "reviewer": {"signals": ["review this change", "review the diff"], "anti_signals": ["implement the change"], "evals": ["agent-reviewer-positive"]},
      "developer": {"signals": ["implement the scoped feature", "apply the agreed design"], "anti_signals": ["review the diff"], "permission_ceiling": "project-edit", "evals": ["agent-developer-positive"]},
      "test-runner": {"signals": ["run the test suite", "validate the implementation"], "anti_signals": ["implement the feature"], "evals": ["agent-test-runner-positive"]},
      "debugger": {"signals": ["diagnose this failure", "find the root cause"], "anti_signals": ["implement the known fix"], "permission_ceiling": "project-edit", "evals": ["agent-debugger-positive"]},
      "architect": {"signals": ["design the architecture", "choose module boundaries"], "anti_signals": ["fix a typo"], "evals": ["agent-architect-positive"]},
      "security-reviewer": {"signals": ["review security boundaries", "security review this change"], "anti_signals": ["apply security fixes"], "evals": ["agent-security-reviewer-positive"]},
      "qa": {"signals": ["design the quality strategy", "define acceptance tests"], "anti_signals": ["fix a typo"], "evals": ["agent-qa-positive"]},
      "devops-engineer": {"signals": ["change the ci pipeline", "deployment infrastructure"], "anti_signals": ["application copy edit"], "permission_ceiling": "project-edit", "network": "task-explicit", "evals": ["agent-devops-engineer-positive"]},
      "documentation": {"signals": ["update the documentation", "write the user guide"], "anti_signals": ["security audit"], "permission_ceiling": "project-edit", "evals": ["agent-documentation-positive"]},
      "backend-engineer": {"signals": ["implement the api endpoint", "backend service change"], "anti_signals": ["frontend styling"], "permission_ceiling": "project-edit", "evals": ["agent-backend-engineer-positive"]},
      "frontend-engineer": {"signals": ["implement the frontend component", "frontend accessibility"], "anti_signals": ["database migration"], "permission_ceiling": "project-edit", "evals": ["agent-frontend-engineer-positive"]},
      "data-engineer": {"signals": ["build the data pipeline", "transform the dataset"], "anti_signals": ["frontend styling"], "permission_ceiling": "project-edit", "evals": ["agent-data-engineer-positive"]},
      "database-engineer": {"signals": ["design the database migration", "optimize the database schema"], "anti_signals": ["frontend styling"], "permission_ceiling": "project-edit", "evals": ["agent-database-engineer-positive"]},
      "cloud-engineer": {"signals": ["provision cloud infrastructure", "cloud deployment architecture"], "anti_signals": ["local documentation edit"], "permission_ceiling": "project-edit", "network": "task-explicit", "evals": ["agent-cloud-engineer-positive"]},
      "ai-ml-engineer": {"signals": ["build the machine learning pipeline", "evaluate the model"], "anti_signals": ["database migration"], "permission_ceiling": "project-edit", "network": "task-explicit", "evals": ["agent-ai-ml-engineer-positive"]},
      "embedded-engineer": {"signals": ["implement firmware", "embedded hardware integration"], "anti_signals": ["web api endpoint"], "permission_ceiling": "project-edit", "evals": ["agent-embedded-engineer-positive"]},
      "performance-engineer": {"signals": ["profile the performance bottleneck", "optimize latency"], "anti_signals": ["fix a typo"], "permission_ceiling": "project-edit", "evals": ["agent-performance-engineer-positive"]},
      "security-engineer": {"signals": ["apply approved security fixes", "harden the implementation"], "anti_signals": ["security review only"], "permission_ceiling": "security-gated", "evals": ["agent-security-engineer-positive"]},
      "context-optimizer": {"signals": ["reduce context usage", "optimize agent context"], "anti_signals": ["application performance"], "evals": ["agent-context-optimizer-positive"]},
      "cost-optimizer": {"signals": ["reduce token cost", "analyze agent spend"], "anti_signals": ["cloud infrastructure cost"], "evals": ["agent-cost-optimizer-positive"]},
      "architecture-auditor": {"signals": ["audit the architecture", "verify dependency boundaries"], "anti_signals": ["design new architecture"], "evals": ["agent-architecture-auditor-positive"]},
      "release-manager": {"signals": ["prepare the release", "coordinate release publication"], "anti_signals": ["implement unrelated feature"], "permission_ceiling": "security-gated", "network": "task-explicit", "evals": ["agent-release-manager-positive"]},
      "migration-agent": {"signals": ["plan the migration", "execute the approved migration"], "anti_signals": ["new greenfield feature"], "permission_ceiling": "security-gated", "evals": ["agent-migration-agent-positive"]}
    },
    "skills": {
      "architecture-map": {"signals": ["architecture map", "module boundaries", "dependency flow"], "anti_signals": ["fix a typo", "single file edit"], "evals": ["skill-architecture-map-positive", "skill-architecture-map-negative"]},
      "dependency-audit": {"signals": ["dependency audit", "supply chain risk", "version drift"], "anti_signals": ["add local function"], "network": "task-explicit", "evals": ["skill-dependency-audit-positive"]},
      "focused-review": {"signals": ["focused review", "review this change", "missing tests"], "anti_signals": ["implement the feature"], "evals": ["skill-focused-review-positive"]},
      "record-bug": {"signals": ["record this bug", "reusable bug solution"], "anti_signals": ["open bug report"], "permission_ceiling": "project-edit", "evals": ["skill-record-bug-positive"]},
      "record-decision": {"signals": ["record this decision", "architecture decision record"], "anti_signals": ["minor implementation detail"], "permission_ceiling": "project-edit", "evals": ["skill-record-decision-positive"]},
      "repo-explore": {"signals": ["explore this repository", "locate the implementation", "orient in the repository"], "anti_signals": ["known file edit"], "evals": ["skill-repo-explore-positive"]},
      "repo-investigate": {"signals": ["investigate repository problem", "trace the failure across files"], "anti_signals": ["obvious single file fix"], "evals": ["skill-repo-investigate-positive"]},
      "search-vault": {"signals": ["search the vault", "find prior decision", "retrieve project memory"], "anti_signals": ["search source code"], "evals": ["skill-search-vault-positive"]},
      "security-hardening": {"signals": ["security hardening workflow", "fix approved security findings", "review fix retest"], "anti_signals": ["security review only", "scan only"], "permission_ceiling": "security-gated", "evals": ["skill-security-hardening-positive", "skill-security-hardening-negative"]},
      "security-rules-check": {"signals": ["security rules check", "check hardcoded credentials", "unsafe functions"], "anti_signals": ["full security audit"], "evals": ["skill-security-rules-check-positive"]},
      "security-scan": {"signals": ["security scan", "security audit", "pre release security review"], "anti_signals": ["fix approved security findings"], "network": "task-explicit", "evals": ["skill-security-scan-positive"]},
      "spec-driven-change": {"signals": ["write a delta spec", "spec driven change", "phase gated spec"], "anti_signals": ["trivial fix"], "permission_ceiling": "project-edit", "evals": ["skill-spec-driven-change-positive"]},
      "structural-search": {"signals": ["structural search", "syntax aware search", "api migration pattern"], "anti_signals": ["simple string search"], "evals": ["skill-structural-search-positive"]},
      "systematic-debugging": {"origin": "ratchery; patterns adapted from MIT-licensed mattpocock/skills and obra/superpowers", "signals": ["systematic debugging", "unexplained failure", "intermittent failure", "repeated fix attempts"], "anti_signals": ["known root cause", "implement the known fix"], "evals": ["skill-systematic-debugging-positive", "skill-systematic-debugging-negative"]},
      "test-driven-development": {"origin": "ratchery; patterns adapted from MIT-licensed mattpocock/skills and obra/superpowers", "signals": ["test driven development", "red green refactor", "behavior first test", "vertical test slice"], "anti_signals": ["documentation only", "generated file", "disposable prototype"], "permission_ceiling": "project-edit", "evals": ["skill-test-driven-development-positive", "skill-test-driven-development-negative"]},
      "work-plan": {"signals": ["plan a complex change", "cross module work plan", "risky migration plan"], "anti_signals": ["trivial edit"], "permission_ceiling": "project-edit", "evals": ["skill-work-plan-positive"]},
      "workspace-resume": {"signals": ["resume this workspace", "returning to this project", "current state is unclear"], "anti_signals": ["new project"], "evals": ["skill-workspace-resume-positive"]},
      "workspace-save": {"signals": ["save workspace state", "persist project handoff", "end this project phase"], "anti_signals": ["raw transcript"], "permission_ceiling": "project-edit", "evals": ["skill-workspace-save-positive"]}
    }
  },
  "agents": {
    "explorer": {
      "activation": "tier-gated",
      "activates_at_tier": "T0",
      "enforced": false,
      "note": "Active by convention from T0 onward; not literally required by tier_requirements()."
    },
    "reviewer": {
      "activation": "tier-gated",
      "activates_at_tier": "T0",
      "enforced": false,
      "note": "Active by convention from T0 onward; not literally required by tier_requirements()."
    },
    "developer": {
      "activation": "tier-gated",
      "activates_at_tier": "T0",
      "enforced": false,
      "note": "Active by convention from T0 onward; not literally required by tier_requirements()."
    },
    "test-runner": {
      "activation": "tier-gated",
      "activates_at_tier": "T1",
      "enforced": false,
      "note": "Recommended from T1 onward by convention; not a literal tier_requirements() entry."
    },
    "debugger": {
      "activation": "tier-gated",
      "activates_at_tier": "T1",
      "enforced": false,
      "note": "Recommended from T1 onward by convention; not a literal tier_requirements() entry."
    },
    "architect": {
      "activation": "tier-gated",
      "activates_at_tier": "T2",
      "enforced": true,
      "note": "Listed verbatim in tier_requirements()['T2'/'T3']['required_agents']."
    },
    "security-reviewer": {
      "activation": "tier-gated",
      "activates_at_tier": "T2",
      "enforced": true,
      "note": "Listed verbatim in tier_requirements()['T2'/'T3']['required_agents']."
    },
    "qa": {
      "activation": "tier-gated",
      "activates_at_tier": "T3",
      "enforced": true,
      "note": "Listed verbatim in tier_requirements()['T3']['required_agents'] (added on top of T2's set)."
    },
    "devops-engineer": {
      "activation": "tier-gated",
      "activates_at_tier": "T2",
      "enforced": false,
      "note": "Recommended from T2 onward by convention (CI required at T2); not a literal tier_requirements() entry."
    },
    "documentation": {
      "activation": "tier-gated",
      "activates_at_tier": "T1",
      "enforced": false,
      "note": "Recommended from T1 onward, aligned with required_docs first appearing at T1; not a literal tier_requirements() entry."
    },
    "backend-engineer": {
      "activation": "conditional",
      "trigger_capability": "api"
    },
    "frontend-engineer": {
      "activation": "conditional",
      "trigger_capability": "frontend"
    },
    "data-engineer": {
      "activation": "conditional",
      "trigger_capability": "data"
    },
    "database-engineer": {
      "activation": "conditional",
      "trigger_capability": "database"
    },
    "cloud-engineer": {
      "activation": "conditional",
      "trigger_capability": "cloud_infra"
    },
    "ai-ml-engineer": {
      "activation": "conditional",
      "trigger_capability": "ai_ml"
    },
    "embedded-engineer": {
      "activation": "on-demand",
      "note": "No reliable static repo signal for embedded work exists in profile(); invoked explicitly rather than guessed."
    },
    "performance-engineer": {
      "activation": "on-demand",
      "note": "Performance work is task-driven, not repo-shape-driven; no static signal is reliable enough to auto-trigger this."
    },
    "security-engineer": {
      "activation": "on-demand"
    },
    "context-optimizer": {
      "activation": "on-demand"
    },
    "cost-optimizer": {
      "activation": "on-demand"
    },
    "architecture-auditor": {
      "activation": "on-demand"
    },
    "release-manager": {
      "activation": "on-demand"
    },
    "migration-agent": {
      "activation": "on-demand"
    }
  },
  "skills": {
    "_comment": "All global Skills are installed and discoverable. Clients inspect compact metadata and load a Skill's body only when its trigger matches; none of these bodies should be described as loaded every session. This list must exactly match the Skill directories on disk.",
    "available": [
      "architecture-map",
      "dependency-audit",
      "focused-review",
      "record-bug",
      "record-decision",
      "repo-explore",
      "repo-investigate",
      "search-vault",
      "security-hardening",
      "security-rules-check",
      "security-scan",
      "spec-driven-change",
      "structural-search",
      "systematic-debugging",
      "test-driven-development",
      "work-plan",
      "workspace-resume",
      "workspace-save"
    ]
  }
}
